# Copy to .env.local for `vercel dev`. Never commit the real file --
# .gitignore covers .env.local, but check before your first push anyway.
#
# In production these are set in the Vercel dashboard instead:
#   Project -> Settings -> Environment Variables
# Set each for Production, Preview and Development, or `vercel dev` and your
# preview deploys will fail with "missing env" while production works fine.


# ---- Supabase ---------------------------------------------------------------
# The project origin. The dashboard shows a REST URL ending in /rest/v1/ --
# lib/db.js trims that, but the bare origin is what belongs here.
SUPABASE_URL=https://fqsjfxkfonpdzvnxexxe.supabase.co

# Settings -> API Keys -> anon / public.
# Public by design: it ships inside the PWA's JavaScript and is fenced by RLS.
# Treat it as a username, not a password.
SUPABASE_ANON_KEY=

# Settings -> API Keys -> service_role.  SECRET.
# Bypasses RLS completely. It exists only inside serverless functions. If this
# ever reaches the browser, every RLS policy in the sibling `pulse` project's
# sql/schema.sql becomes decoration.
# Never put it in public/, never log it, never paste it into a chat window.
SUPABASE_SERVICE_ROLE_KEY=


# ---- The tag ----------------------------------------------------------------
# A capability, not an identity: it authorises "append one drink" and nothing
# else. Anyone who taps the sticker on your wrist can read it, so the worst it
# can do must be to log a phantom drink.
#
# Generate one:
#     openssl rand -hex 32
#
# Goes in three places, identically: here, the Vercel dashboard, and the
# iOS Shortcut's x-tag-token header.
TAG_TOKEN=


# ---- Manual sync button -----------------------------------------------------
# Lets the PWA's ⟳ button kick the GitHub Actions sync, because the cron is
# best-effort: it asks for hourly and real gaps run 2.5-4h.
#
# A FINE-GRAINED token, scoped to this repository only, with exactly one
# permission: Actions -> Read and write. Nothing else. Create it at
#     github.com/settings/personal-access-tokens
#
# This is a bigger capability than TAG_TOKEN. That one can append a drink; this
# one can run workflows on the repo, so treat it like a password: server-side
# only, never in public/, never in a commit. api/sync.js is the only reader.
#
# Fine-grained tokens expire. When it does, the button returns
# "GitHub token rejected — expired or revoked" rather than failing silently;
# issue a new one and update it here and in Vercel.
GH_DISPATCH_TOKEN=

# Optional. Vercel sets VERCEL_GIT_REPO_OWNER/SLUG for repo-linked projects, so
# these are only needed if that is not the case or you want to override.
# GH_REPO=YoyoyorkLi/fitbitair-pwa
# GH_WORKFLOW=sync.yml
# GH_REF=main


# ---- Optional ---------------------------------------------------------------
# IANA zone for the 4am night boundary. Must match drink_night() in the
# sibling `pulse` project's sql/schema.sql, and PULSE_TZ in its .env for the
# Python sync -- three places, one answer.
PULSE_TZ=America/Chicago
