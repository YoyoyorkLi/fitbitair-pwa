node_modules/
.vercel/
.env.local
.env*.local
.DS_Store

# build-preview.mjs's default output. Generated from public/ on demand, so it
# is never the source of anything -- and at ~85kb of inlined CSS+JS it makes
# every diff that touches a chart unreadable.
preview.html

# ---- pulse/ (the Google Health sync, moved in from the sibling project) ----
pulse/.venv/
pulse/**/__pycache__/
pulse/**/*.pyc
pulse/pulse.db
pulse/pulse-demo.db
pulse/dashboard.html

# Google credentials + the live refresh token. This repo is PUBLIC --
# .token.json in particular is a standing credential, not a config value;
# treat a leak of it the same as a leaked password.
pulse/.env
pulse/.env.bak.*
pulse/.token.json
pulse/client_secret*.json
.vercel

# Added by the Vercel CLI. Deliberately broad -- any stray .env variant is
# ignored by default -- with one carve-out: .env.example carries no secrets,
# is the file README and WORKFLOW.md tell you to copy, and .env* would have
# quietly dropped it the first time anyone deleted and re-added it.
.env*
!.env.example
